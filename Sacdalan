def debugging_challenge(progress):
    challenge = random.choice(debug_challenges)

    title, description, buggy_code, expected = challenge

    print("\n========== DEBUGGING CHALLENGE ==========")
    print("Challenge:", title)
    print("Task:", description)

    print("\nBUGGY CODE:")
    print("-" * 45)
    print(buggy_code)
    print("-" * 45)

    print("\nFind and correct the error.")

    code = read_code()

    if not code.strip():
        print("No code entered.")
        return

    try:
        result = run_code(code)

        actual = result.stdout.strip()

        print("\n========== DEBUGGING RESULT ==========")

        if result.returncode == 0 and actual == expected:
            print("Correct! You fixed the bug!")
            print("+20 points")

            progress["points"] += 20
            progress["debug_solved"] += 1

        else:
            print("Not correct yet. Keep practicing!")

            if result.stderr:
                print("\nPython Error:")
                print(result.stderr)

            print("\nExpected output:")
            print(expected)

            print("\nYour output:")
            print(actual if actual else "(No output)")

        save_progress(progress)

    except subprocess.TimeoutExpired:
        print("Time limit reached. Check your loop.")

    except OSError as error:
        print("Could not test code:", error)


