def coding_lab():
    challenge = random.choice(coding_challenges)

    print("\n========== PYTHON CODING LAB ==========")
    print("Topic:", challenge[0])
    print("Task:", challenge[1])
    print("Example:", challenge[2])

    code = read_code()

    if not code.strip():
        print("No code entered.")
        return

    try:
        print("\n========== YOUR PROGRAM OUTPUT ==========")

        result = run_code(code, timeout=10)

        if result.stdout:
            print(result.stdout)

        if result.stderr:
            print(result.stderr)

        if result.returncode == 0:
            print("Program executed successfully!")
            print("Review your output against the task.")
        else:
            print("Your program contains an error.")
            print("Check the error message and try again.")

    except subprocess.TimeoutExpired:
        print("Time limit reached.")
        print("Check for an infinite loop.")

    except OSError as error:
        print("Could not run code:", error)


