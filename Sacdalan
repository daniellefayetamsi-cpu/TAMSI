def take_quiz(progress):
    print("\n========== RANDOM PYTHON QUIZ ==========")

    selected = random.sample(question_bank, 5)
    score = 0

    for number, item in enumerate(selected, 1):
        question, options, correct, topic = item

        print(f"\nQuestion {number}/5")
        print("Topic:", lessons[topic]["title"])
        print(question)

        shuffled = list(enumerate(options))
        random.shuffle(shuffled)

        for index, (_, option) in enumerate(shuffled):
            letter = chr(65 + index)
            print(f"{letter}. {option}")

        while True:
            answer = input("Your answer (A-D): ").strip().upper()

            if answer in ("A", "B", "C", "D"):
                break

            print("Invalid answer. Choose A, B, C, or D.")

        selected_index = ord(answer) - 65
        original_index = shuffled[selected_index][0]

        if original_index == correct:
            print("Correct! +10 points")
            score += 1
            progress["points"] += 10
        else:
            print("Incorrect.")
            print("Correct answer:", options[correct])

    progress["quizzes"] += 1

    print("\n========== QUIZ RESULT ==========")
    print(f"Score: {score}/5")
    print(f"Points earned: {score * 10}")

    save_progress(progress)


# ==========================================
# READ MULTILINE PYTHON CODE
# ==========================================

def read_code():
    print("\nEnter your Python code.")
    print("Type END on a separate line when finished.")
    print("Type CANCEL on the first line to return.")

    lines = []

    while True:
        try:
            line = input()
        except EOFError:
            return ""

        if line.strip().upper() == "CANCEL" and not lines:
            return ""

        if line.strip().upper() == "END":
            break

        lines.append(line)

    return "\n".join(lines)


# ==========================================
# RUN STUDENT CODE
# ==========================================

def run_code(code, timeout=5):
    # Only execute Python code that you trust.
    # This runs code locally, not in a secure sandbox.

    with tempfile.TemporaryDirectory() as folder:
        path = os.path.join(folder, "student_code.py")

        with open(path, "w", encoding="utf-8") as file:
            file.write(code)

        result = subprocess.run(
            [sys.executable, "-I", path],
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=folder
        )

        return result


